# ───────────────────────────────────────────────
# AutoBlog generator — copy this to ".env" and fill in.
# Nothing is required to RUN the demo (it falls back to mock/free providers),
# but DeepSeek makes the articles real.
# ───────────────────────────────────────────────

# --- DeepSeek (article writing) ---  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Feature image provider ---
# pollinations = free, no key (default).  openai = DALL-E.  gemini = Google.  placeholder = picsum.
IMAGE_PROVIDER=pollinations
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- SEO data (optional). Without it, keyword/competitor steps use the LLM instead. ---
SEMRUSH_API_KEY=

# --- Storage backend: "local" (JSON file, zero setup) or "supabase" (bridge to the Next.js sites) ---
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
